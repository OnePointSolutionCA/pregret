HOMEDEPOT_AFFILIATE_TAG=
COSTCO_AFFILIATE_TAG=
NEWEGG_AFFILIATE_TAG=
EBAY_AFFILIATE_TAG=
ALIEXPRESS_AFFILIATE_TAG=

# Universal networks — one tag/id covers hundreds of merchants
IMPACT_AFFILIATE_ID=
CJ_AFFILIATE_ID=
